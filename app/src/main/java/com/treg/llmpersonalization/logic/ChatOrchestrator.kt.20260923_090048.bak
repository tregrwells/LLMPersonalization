package com.treg.llmpersonalization.logic

import com.treg.llmpersonalization.engine.EmbedderBridge
import com.treg.llmpersonalization.engine.ExtractorBridge
import com.treg.llmpersonalization.engine.GenerationConfig
import com.treg.llmpersonalization.engine.LlamaBridge
import com.treg.llmpersonalization.engine.RerankerBridge
import org.json.JSONObject
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

/**
 * Runtime v15 orchestrator.
 *
 * Two paths, selected at construction:
 *   - Legacy path  : memoryStore/embedder/reranker are null (demo v2.0 behaviour)
 *   - v15 path     : all three provided (full CognitiveRuntime.respond port)
 *
 * The public `chat()` signature and Trace fields are unchanged from demo v2.0.
 * New Trace fields (path, topMemory, topScore, toolResults, strippedQuery)
 * default to safe values so existing UI code keeps compiling.
 */
class ChatOrchestrator(
    private val llama: LlamaBridge.Loaded,
    private val extractor: ExtractorBridge,
    private val beliefs: BeliefStore,
    private val memoryStore: MemoryStore? = null,
    private val embedder: EmbedderBridge? = null,
    private val reranker: RerankerBridge? = null
) {
    private val retriever: Retriever? =
        if (memoryStore != null && embedder != null && reranker != null)
            Retriever(memoryStore, embedder, reranker)
        else null

    data class Trace(
        // ---- legacy fields (UI depends on these) ----
        val user: String,
        val message: String,
        val kind: String,
        val mined: BeliefStore.Mined?,
        val conceptKey: String?,
        val conf: Float?,
        val source: String?,
        val gate: String?,
        val applied: String?,
        val gap: Float?,
        val offset: Float?,
        val skipped: String?,
        val think: String?,
        val response: String,
        // ---- v15 additions (defaulted for compatibility) ----
        val path: String = "legacy",
        val strippedQuery: String? = null,
        val topMemory: String? = null,
        val topScore: Float? = null,
        val toolResults: List<String>? = null
    )

    fun chat(
        message: String,
        user: String,
        softGate: Boolean = true,
        strictGate: Boolean = true,
        useBeliefs: Boolean = true,
        useMining: Boolean = true,
        expanded: Boolean = false
    ): Trace {
        val r = retriever
        return if (r == null) {
            legacyChat(message, user, softGate, strictGate, useBeliefs, useMining, expanded)
        } else {
            v15Chat(message, user, strictGate, useBeliefs, useMining, r)
        }
    }

    // ==================================================================
    // v15 PATH
    // ==================================================================

    private fun v15Chat(
        message: String,
        user: String,
        strictGate: Boolean,
        useBeliefs: Boolean,
        useMining: Boolean,
        retriever: Retriever
    ): Trace {
        val stripped = PreambleStripper.strip(message)
        val ctx = QueryClassifier.classify(stripped)

        // Extractor (demo path) — used for mining and confidence reporting
        val ex = extractor.extract(stripped)
        val mined = if (useMining) {
            beliefs.acquireBelief(stripped, if (ex.uri == "NONE") null else ex.uri)
        } else null

        val kind = MessageClassifier.classify(stripped).name.lowercase()
        val strippedIfChanged = if (stripped != message) stripped else null

        // ---- 1. BELIEF PATH ----
        if (ctx.concept != null && useBeliefs) {
            val ck = QueryClassifier.conceptKey(ctx.concept)
            val eff = beliefs.getEffectiveBelief(ck)
            var target: String? = eff.target
            var gateLabel = "lookup: ${eff.source}"

            val ref = beliefs.referenceFor(ck)
            if (target != null && strictGate && beliefs.isContradicted(ck, target)) {
                gateLabel = "BLOCKED '${target.trim()}' -> '${ref?.trim()}'"
                target = ref
            } else if (target != null && ref != null) {
                gateLabel = "PASS (ref='${ref.trim()}')"
            } else if (target != null) {
                gateLabel = "PASS (no reference)"
            }

            if (target != null) {
                val prompt = PromptAssembler.assemble(
                    stripped, emptyList(), ctx, beliefTarget = target
                )
                val formatted = LlamaBridge.formatChat(llama, prompt.system, prompt.user)

                val tid = llamaTokenizeSingle(target)
                val gap = if (tid >= 0) LlamaBridge.computeGapRaw(llama, formatted, tid) else 999f
                val offset = GenerationConfig.sigmoidOffset(gap)

                val raw = if (tid >= 0)
                    LlamaBridge.generateRaw(llama, formatted, tid, offset, 30, 0f)
                else
                    LlamaBridge.generateRaw(llama, formatted, null, null, 30, 0f)

                val (think, cleaned) = TextPipeline.postProcess(raw)

                return Trace(
                    user = user, message = message, kind = kind,
                    mined = mined, conceptKey = ck, conf = ex.confidence,
                    source = eff.source, gate = gateLabel, applied = target,
                    gap = gap, offset = offset, skipped = null,
                    think = think, response = cleaned,
                    path = "belief",
                    strippedQuery = strippedIfChanged
                )
            }
            // target null after all -> fall through to personal
        }

        // ---- 2. WORLD PATH ----
        if (ctx.subject == "unspecified" && ctx.concept == null) {
            val prompt = PromptAssembler.assemble(stripped, emptyList(), ctx, worldMode = true)
            var formatted = LlamaBridge.formatChat(llama, prompt.system, prompt.user)
            var raw = LlamaBridge.generateRaw(llama, formatted, null, null, 100, 0.7f)

            val toolResults = mutableListOf<String>()
            var iter = 0
            while (iter < 3) {
                val call = parseToolCall(raw) ?: break
                val result = executeTool(call)
                toolResults.add("${call.tool}(${call.args}) = $result")
                val next = PromptAssembler.assemble(
                    stripped, emptyList(), ctx,
                    toolResults = toolResults, worldMode = true
                )
                formatted = LlamaBridge.formatChat(llama, next.system, next.user)
                raw = LlamaBridge.generateRaw(llama, formatted, null, null, 100, 0.7f)
                iter++
            }
            val (think, cleaned) = TextPipeline.postProcess(raw)
            return Trace(
                user = user, message = message, kind = kind,
                mined = mined, conceptKey = null, conf = ex.confidence,
                source = null, gate = null, applied = null,
                gap = null, offset = null, skipped = null,
                think = think, response = cleaned,
                path = if (toolResults.isEmpty()) "world" else "tool",
                strippedQuery = strippedIfChanged,
                toolResults = toolResults.ifEmpty { null }
            )
        }

        // ---- 3. PERSONAL PATH ----
        val isMulti = Retriever.isMultiMemory(stripped)
        val k = if (isMulti) 8 else 5
        val threshold = if (isMulti) MULTI_CONF_THR else CONF_THR

        val memories = retriever.retrieve(stripped, ctx, k = k)
        val topMem = memories.firstOrNull()
        val topScore = topMem?.score

        if (memories.isEmpty() || (topScore != null && topScore < threshold)) {
            return Trace(
                user = user, message = message, kind = kind,
                mined = mined, conceptKey = null, conf = ex.confidence,
                source = null, gate = "gate_refused", applied = null,
                gap = null, offset = null, skipped = null,
                think = null,
                response = "I don't have information about that in my memory.",
                path = "gate_refused",
                strippedQuery = strippedIfChanged,
                topMemory = topMem?.key,
                topScore = topScore
            )
        }

        val prompt = PromptAssembler.assemble(stripped, memories, ctx)
        var formatted = LlamaBridge.formatChat(llama, prompt.system, prompt.user)
        var raw = LlamaBridge.generateRaw(llama, formatted, null, null, 100, 0.7f)

        val toolResults = mutableListOf<String>()
        var iter = 0
        while (iter < 3) {
            val call = parseToolCall(raw) ?: break
            val result = executeTool(call)
            toolResults.add("${call.tool}(${call.args}) = $result")
            val next = PromptAssembler.assemble(
                stripped, memories, ctx, toolResults = toolResults
            )
            formatted = LlamaBridge.formatChat(llama, next.system, next.user)
            raw = LlamaBridge.generateRaw(llama, formatted, null, null, 100, 0.7f)
            iter++
        }
        val (think, cleaned) = TextPipeline.postProcess(raw)
        return Trace(
            user = user, message = message, kind = kind,
            mined = mined, conceptKey = null, conf = ex.confidence,
            source = null, gate = null, applied = null,
            gap = null, offset = null, skipped = null,
            think = think, response = cleaned,
            path = if (toolResults.isEmpty()) "standard" else "tool",
            strippedQuery = strippedIfChanged,
            topMemory = topMem?.key,
            topScore = topScore,
            toolResults = toolResults.ifEmpty { null }
        )
    }

    // ==================================================================
    // LEGACY PATH (demo v2.0 — kept verbatim for fallback)
    // ==================================================================

    private fun legacyChat(
        message: String,
        user: String,
        softGate: Boolean,
        strictGate: Boolean,
        useBeliefs: Boolean,
        useMining: Boolean,
        expanded: Boolean
    ): Trace {
        val ex = extractor.extract(message)

        val mined = if (useMining) {
            beliefs.acquireBelief(message, if (ex.uri == "NONE") null else ex.uri)
        } else null

        val kind = MessageClassifier.classify(message)
        val subject = MessageClassifier.extractSubject(message)
        val conceptKey = if (ex.uri != "NONE" && !subject.isNullOrEmpty())
            beliefs.conceptKey(ex.uri, subject)
        else null

        var appliedTarget: String? = null
        var gateLabel: String? = null
        var skipped: String? = null
        var gap: Float? = null
        var offset: Float? = null
        var targetToken: Int? = null

        when {
            kind == MessageClassifier.Kind.ASSERTION -> {
                val (refTarget, label) = applyAssertionGate(message, conceptKey, softGate)
                gateLabel = label
                if (refTarget != null) {
                    val g = llamaComputeGap(message, refTarget)
                    gap = g
                    if (g > GenerationConfig.MAX_SAFE_GAP) {
                        skipped = "assertion gap $g > ${GenerationConfig.MAX_SAFE_GAP}"
                    } else {
                        offset = GenerationConfig.sigmoidOffset(g)
                        appliedTarget = refTarget
                        targetToken = llamaTokenizeSingle(refTarget)
                    }
                }
            }
            kind == MessageClassifier.Kind.QUESTION && useBeliefs && conceptKey != null -> {
                val eff = beliefs.getEffectiveBelief(conceptKey)
                gateLabel = "lookup: ${eff.source}"
                if (eff.target != null) {
                    var t = eff.target
                    val ref = beliefs.referenceFor(conceptKey)
                    if (strictGate && beliefs.isContradicted(conceptKey, t)) {
                        gateLabel = "BLOCKED '${t.trim()}' -> '${ref?.trim()}'"
                        t = ref!!
                    } else if (ref != null) {
                        gateLabel = "PASS (ref='${ref.trim()}')"
                    } else {
                        gateLabel = "PASS (no reference)"
                    }
                    val g = llamaComputeGap(message, t)
                    gap = g
                    if (g > GenerationConfig.MAX_SAFE_GAP) {
                        skipped = "gap $g > ${GenerationConfig.MAX_SAFE_GAP}"
                    } else {
                        offset = GenerationConfig.sigmoidOffset(g)
                        appliedTarget = t
                        targetToken = llamaTokenizeSingle(t)
                    }
                }
            }
        }

        val route = GenerationConfig.route(hasBelief = appliedTarget != null, expanded = expanded)
        val rawResponse = LlamaBridge.generate(
            loaded = llama,
            prompt = message,
            targetToken = targetToken,
            offset = offset,
            maxTokens = route.maxTokens,
            temperature = route.temperature
        )

        val (think, cleaned) = TextPipeline.extractThink(rawResponse)

        return Trace(
            user = user, message = message,
            kind = kind.name.lowercase(),
            mined = mined,
            conceptKey = conceptKey,
            conf = ex.confidence,
            source = if (kind == MessageClassifier.Kind.QUESTION)
                gateLabel?.substringAfter("lookup: ") else null,
            gate = gateLabel,
            applied = appliedTarget,
            gap = gap,
            offset = offset,
            skipped = skipped,
            think = think,
            response = cleaned
        )
    }

    private fun applyAssertionGate(
        message: String,
        conceptKey: String?,
        softGate: Boolean
    ): Pair<String?, String> {
        if (!softGate) return null to "soft_gate_off"
        val (subj, target) = MessageClassifier.parseAssertion(message)
        if (subj.isNullOrEmpty() || target.isNullOrEmpty()) return null to "unparseable_assertion"
        if (conceptKey == null) return null to "no_concept"
        val ref = beliefs.referenceFor(conceptKey) ?: return null to "not_in_reference"
        if (!beliefs.isContradicted(conceptKey, target)) return null to "consistent_with_reference"
        return ref to "ASSERTION_BLOCKED '${target.trim()}' -> '${ref.trim()}'"
    }

    // ==================================================================
    // LLAMA HELPERS
    // ==================================================================

    private fun llamaComputeGap(prompt: String, target: String): Float {
        val tid = llamaTokenizeSingle(target) ?: return 999f
        return LlamaBridge.computeGap(llama, prompt, tid)
    }

    private fun llamaTokenizeSingle(text: String): Int? {
        val ids = LlamaBridge.tokenize(llama, text) ?: return null
        return if (ids.isEmpty()) null else ids[0]
    }

    // ==================================================================
    // TOOL OVERLAY (inline for patch 5; extracted to ToolOverlay.kt later)
    // ==================================================================

    private data class ToolCall(val tool: String, val args: Map<String, Any?>)

    private fun parseToolCall(text: String): ToolCall? {
        val m = Regex("""<tool_call>\s*(\{.*?\})\s*</tool_call>""", RegexOption.DOT_MATCHES_ALL)
            .find(text) ?: return null
        return try {
            val json = JSONObject(m.groupValues[1])
            val tool = json.getString("tool")
            val argsObj = json.optJSONObject("args") ?: JSONObject()
            val args = mutableMapOf<String, Any?>()
            for (k in argsObj.keys()) args[k] = argsObj.get(k)
            ToolCall(tool, args)
        } catch (_: Exception) { null }
    }

    private fun executeTool(call: ToolCall): String {
        return try {
            when (call.tool) {
                "calculator" -> {
                    val expr = call.args["expression"] as? String
                    if (expr == null) "error: missing expression"
                    else evalArithmetic(expr)?.toString() ?: "error: bad expression"
                }
                "word_count" -> {
                    val text = call.args["text"] as? String
                    if (text == null) "error: missing text"
                    else text.split(Regex("""\s+""")).count { it.isNotEmpty() }.toString()
                }
                "datetime" -> {
                    SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US).format(Date())
                }
                else -> "error: unknown tool '${call.tool}'"
            }
        } catch (e: Exception) { "error: ${e.message}" }
    }

    // Minimal safe arithmetic parser: + - * / % ^ parens unary. No code execution.
    private fun evalArithmetic(expr: String): Double? {
        val tokens = tokenizeArith(expr) ?: return null
        var idx = 0
        fun peek(): String? = if (idx < tokens.size) tokens[idx] else null
        fun next(): String = tokens[idx++]

        fun parsePrimary(): Double? {
            val t = peek() ?: return null
            if (t == "(") {
                next()
                val v = parseAdd() ?: return null
                if (peek() != ")") return null
                next()
                return v
            }
            if (t == "-") { next(); val v = parsePrimary() ?: return null; return -v }
            if (t == "+") { next(); return parsePrimary() }
            return t.toDoubleOrNull()?.also { next() }
        }
        fun parsePow(): Double? {
            val base = parsePrimary() ?: return null
            if (peek() == "^") { next(); val e = parsePow() ?: return null; return Math.pow(base, e) }
            return base
        }
        fun parseMul(): Double? {
            var v = parsePow() ?: return null
            while (peek() in listOf("*", "/", "%")) {
                val op = next(); val r = parsePow() ?: return null
                v = when (op) { "*" -> v * r; "/" -> v / r; else -> v % r }
            }
            return v
        }
        fun parseAdd(): Double? {
            var v = parseMul() ?: return null
            while (peek() in listOf("+", "-")) {
                val op = next(); val r = parseMul() ?: return null
                v = if (op == "+") v + r else v - r
            }
            return v
        }
        val result = parseAdd() ?: return null
        return if (idx == tokens.size) result else null
    }

    private fun tokenizeArith(s: String): List<String>? {
        val out = mutableListOf<String>()
        var i = 0
        while (i < s.length) {
            val c = s[i]
            when {
                c.isWhitespace() -> i++
                c.isDigit() || c == '.' -> {
                    val start = i
                    while (i < s.length && (s[i].isDigit() || s[i] == '.')) i++
                    out.add(s.substring(start, i))
                }
                c in "+-*/%^()" -> { out.add(c.toString()); i++ }
                else -> return null
            }
        }
        return out
    }

    companion object {
        // Calibrated thresholds from runtime v15 (Part 6, Cell 1)
        private const val CONF_THR = -0.75f
        private const val MULTI_CONF_THR = -3.0f
    }
}